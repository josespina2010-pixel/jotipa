# GEMINI_API_KEY: Clave de API de Google Gemini (solo en el servidor).
GEMINI_API_KEY=""

# VITE_GOOGLE_MAPS_API_KEY: Clave pública de Google Maps Platform (Maps JS API).
VITE_GOOGLE_MAPS_API_KEY=""

# SUPABASE_URL: URL del proyecto en Supabase (ej. https://xxxx.supabase.co).
SUPABASE_URL=""

# SUPABASE_SERVICE_ROLE_KEY: Clave privada de servicio de Supabase (solo en el servidor).
SUPABASE_SERVICE_ROLE_KEY=""

# SUPABASE_ANON_KEY: Clave anónima opcional si no se usa service role en desarrollo.
SUPABASE_ANON_KEY=""

# PORT: Puerto del servidor Express (Render lo asigna automáticamente; 3000 en desarrollo).
PORT="3000"

# APP_URL: URL pública de la aplicación desplegada (Render / AI Studio).
APP_URL=""
